{
  "name": "github-qol",
  "description": "Quality-of-life tweaks for GitHub pull requests.",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs && tailwindcss -i src/css/tailwind.css -o src/css/outputTailwind.css --minify",
    "build:js": "node build.mjs",
    "build:css": "tailwindcss -i src/css/tailwind.css -o src/css/outputTailwind.css --minify",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
